# ── Metadata ──────────────────────────────────────────────────────────────
# Override the TMDB proxy host if the domain changes.
NEXT_PUBLIC_CINEZO_BASE=https://cinezo.org

# ── Anime metadata (AniList primary, Jikan fallback) ──────────────────────
ANILIST_BASE=https://graphql.anilist.co
JIKAN_BASE=https://api.jikan.moe/v4

# ── Hindi / Desi movie sources (download-oriented, ordered fallback) ──────
# sevenhitmovies = WordPress REST API (clean JSON), domain rotates frequently.
MOVIE_PROVIDER_ORDER=sevenhitmovies
SEVENHITMOVIES_BASE=https://7hitmovies.net

# ── Free shortener/protector bypass (server-side) ─────────────────────────
# The following need a FREE account on the respective protector — register,
# grab the cookie/token from your browser, and paste it here. Then the
# "resolve" button turns their links directly into Google Drive URLs.
#
# GDToT (gdtot.*) — `crypt` cookie
GDTOT_CRYPT=
# Sharer.pw — XSRF-TOKEN + laravel_session cookies
SHARER_XSRF_TOKEN=
SHARER_LARAVEL_SESSION=
# AppDrive family (appdrive.in / driveapp.in / drivehub.in / gdflix.pro / …)
APPDRIVE_EMAIL=
APPDRIVE_PASSWORD=

# ── Anime stream providers (ordered fallback) ─────────────────────────────
# animelok = LIVE source (animelok.live, ex Animerulz) — Japanese + regional
#            dubs (Hindi/Telugu/Tamil), direct m3u8 server-side rendered.
# animepahe = `@consumet/extensions` AnimePahe (sub-only). Its base domain
#             rotates between official mirrors (animepahe.si/.com/.org).
ANIME_PROVIDER_ORDER=animelok,animepahe
ANIMELOK_BASE=https://animelok.live
ANIMEPAHE_BASE=https://animepahe.com

# ── Security ─────────────────────────────────────────────────────────────
# Persistent bot-ban list (cross-restart). Create a free Upstash Redis DB and
# paste the REST URL + token. Leave empty to use in-memory bans only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret used to sign the JS-challenge clearance cookie (optional; a fallback
# is used if unset — set a strong random value for production).
CHALLENGE_SECRET=
