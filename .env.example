# ── Metadata ──────────────────────────────────────────────────────────────
# Override the TMDB proxy host if the domain changes.
NEXT_PUBLIC_CINEZO_BASE=https://cinezo.org

# ── Anime metadata (AniList primary, Jikan fallback) ──────────────────────
ANILIST_BASE=https://graphql.anilist.co
JIKAN_BASE=https://api.jikan.moe/v4

# ── Anime stream providers (ordered fallback) ─────────────────────────────
ANIME_PROVIDER_ORDER=hianime,consumet
HIANIME_BASE=https://hianime.to
CONSUMET_BASE=https://api.consumet.org

# Optional: AES-256 key for HiAnime's encrypted `sources` payload.
# HiAnime rotates this occasionally — leave unset to rely on the Consumet
# fallback if the direct decryption can't be verified against upstream.
# HIANIME_SOURCES_KEY=
